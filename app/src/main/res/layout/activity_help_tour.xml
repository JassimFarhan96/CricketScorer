<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/c_bg_page">

  <!-- ── Header ───────────────────────────────────────────────────────────── -->
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:gravity="center_vertical"
      android:background="@color/green_dark"
      android:paddingStart="20dp" android:paddingEnd="20dp"
      android:paddingTop="40dp"  android:paddingBottom="16dp">

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
      <TextView android:id="@+id/tour_step_label"
          android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:text="STEP 1 OF 11" android:textColor="#AADECE"
          android:textSize="11sp" android:letterSpacing="0.1"
          android:fontFamily="sans-serif-medium"/>
      <TextView android:id="@+id/tour_title"
          android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:text="Welcome" android:textColor="#FFFFFF"
          android:textSize="22sp" android:fontFamily="sans-serif-medium"
          android:textStyle="bold" android:layout_marginTop="2dp"/>
    </LinearLayout>

    <TextView android:id="@+id/tour_skip"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Skip" android:textColor="#FFFFFF"
        android:textSize="14sp" android:fontFamily="sans-serif-medium"
        android:padding="8dp" android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true" android:focusable="true"/>
  </LinearLayout>

  <!-- ── Progress dots ────────────────────────────────────────────────────── -->
  <LinearLayout android:id="@+id/tour_dots"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:gravity="center"
      android:background="@color/green_dark"
      android:paddingBottom="14dp"/>

  <!-- ── Scrollable content ───────────────────────────────────────────────── -->
  <ScrollView android:id="@+id/tour_scroll"
      android:layout_width="match_parent" android:layout_height="0dp"
      android:layout_weight="1" android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

      <!-- Short intro line under the title -->
      <TextView android:id="@+id/tour_subtitle"
          android:layout_width="match_parent" android:layout_height="wrap_content"
          android:text=""
          android:textColor="@color/c_text_secondary" android:textSize="14sp"
          android:lineSpacingMultiplier="1.3"
          android:layout_marginBottom="20dp"/>

      <!-- Visual mockup container - filled per page -->
      <FrameLayout android:id="@+id/tour_mockup"
          android:layout_width="match_parent" android:layout_height="wrap_content"
          android:layout_marginBottom="16dp"/>

      <!-- Hint label - changes based on hotspot taps -->
      <androidx.cardview.widget.CardView
          android:id="@+id/tour_hint_card"
          xmlns:app="http://schemas.android.com/apk/res-auto"
          android:layout_width="match_parent" android:layout_height="wrap_content"
          app:cardCornerRadius="12dp" app:cardElevation="0dp"
          app:cardBackgroundColor="@color/green_light"
          android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:padding="14dp"
            android:gravity="center_vertical">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
              android:text="💡" android:textSize="20sp" android:layout_marginEnd="10dp"/>
          <TextView android:id="@+id/tour_hint_text"
              android:layout_width="0dp" android:layout_height="wrap_content"
              android:layout_weight="1"
              android:textColor="@color/green_dark" android:textSize="13sp"
              android:lineSpacingMultiplier="1.3"/>
        </LinearLayout>
      </androidx.cardview.widget.CardView>

      <!-- Body / bullet points -->
      <LinearLayout android:id="@+id/tour_body"
          android:layout_width="match_parent" android:layout_height="wrap_content"
          android:orientation="vertical" android:layout_marginTop="16dp"/>

    </LinearLayout>
  </ScrollView>

  <!-- ── Bottom navigation ────────────────────────────────────────────────── -->
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:gravity="center_vertical"
      android:background="@color/c_bg_card"
      android:elevation="8dp"
      android:padding="14dp">

    <Button android:id="@+id/tour_prev"
        android:layout_width="0dp" android:layout_height="48dp"
        android:layout_weight="1" android:layout_marginEnd="8dp"
        android:text="Back" android:textAllCaps="false"
        android:textColor="@color/green_dark"
        android:background="@android:color/transparent"
        android:fontFamily="sans-serif-medium"/>

    <Button android:id="@+id/tour_next"
        android:layout_width="0dp" android:layout_height="48dp"
        android:layout_weight="2" android:layout_marginStart="8dp"
        android:text="Next" android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:background="@drawable/bg_tour_next_btn"
        android:fontFamily="sans-serif-medium" android:textStyle="bold"/>
  </LinearLayout>

</LinearLayout>
