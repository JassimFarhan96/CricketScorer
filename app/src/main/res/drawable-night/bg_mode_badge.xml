<?xml version="1.0" encoding="utf-8"?>
<!--
  bg_mode_badge.xml (night mode)
  Adds a white stroke so the Edit Overs / Single bat / Two bat badges are
  clearly distinguishable against the dark green header background in dark mode.
  The fill matches c_mode_badge_bg (#0F4E3D) and text is white (#FFFFFF via
  c_mode_badge_fg in values-night/colors.xml).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/c_mode_badge_bg"/>
    <stroke android:width="1dp" android:color="#FFFFFF"/>
    <corners android:radius="20dp"/>
</shape>
